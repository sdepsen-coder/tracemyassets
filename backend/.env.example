ENVIRONMENT=development
DATABASE_URL=sqlite:///./tracemyassets.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
# Generate a random secret locally; never commit the real value.
AUTH_SECRET_KEY=
# Set the real secret only in your local .env file.
WATERMARK_SECRET_HEX=

# Discovery provider(s) for monitoring scans. Comma-separated to run
# several together per scan (results are pooled, each tagged by its
# own provider -- see app/services/visual_search_provider.py).
# "fake" (the default if unset) needs no credentials and doesn't scan
# the public web -- keep it for local dev unless you have real keys.
VISUAL_SEARCH_PROVIDER=fake
# google-vision: paste the full contents of a Google Cloud service
# account JSON key here (see google_vision_visual_search.py for setup).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# rainforest-amazon: API key from https://www.rainforestapi.com
RAINFOREST_API_KEY=
# rainforest-amazon: comma-separated Amazon domains to search.
# Defaults to amazon.co.uk if unset. Each extra domain is a separate
# billed Rainforest request per scan.
RAINFOREST_AMAZON_DOMAINS=amazon.co.uk
# etsy: from https://www.etsy.com/developers/register (no OAuth needed).
# The app must be approved by Etsy first. Etsy's error text mentions a
# shared secret, so the value may need to be "keystring:shared_secret".
ETSY_API_KEY=
# Deep scan (optional, costs money per search): Google Lens exact matches
# through SerpApi, run only when a deep scan is asked for -- never listed in
# VISUAL_SEARCH_PROVIDER. Needs both values below.
SERPAPI_API_KEY=
# Public address of this backend (e.g. the Railway URL, no trailing slash).
# SerpApi/Google fetch the artwork's protected copy from a signed link under
# it that expires after 10 minutes.
PUBLIC_BACKEND_URL=
# Our own count of searches, set to the SerpApi plan (calendar day / month,
# UTC). The app refuses deep scans once either is used up.
SERPAPI_DAILY_LIMIT=200
SERPAPI_MONTHLY_LIMIT=1000
